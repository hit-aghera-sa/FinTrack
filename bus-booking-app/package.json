{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:app": "node -e \"const f=require('fs');const s=f.existsSync('prisma/schema.prisma')?'':f.existsSync('prisma/schema')?' --schema prisma/schema':null;if(s!==null)require('child_process').execSync('prisma generate'+s,{stdio:'inherit'})\" && vite build --outDir dist/client && tsc -p tsconfig.server.json && node scripts/seal-dist-esm.mjs",
    "build": "npm run build:app && tsc -p tsconfig.json --noEmit",
    "start": "node dist/server/index.js",
    "preview": "vite preview --outDir dist/client",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "test:acceptance": "playwright test --config=playwright.config.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "bcrypt": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "prisma": "^6.19.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "@types/bcrypt": "^5.0.2",
    "tsx": "^4.19.2",
    "@types/express": "^4.17.21",
    "@testing-library/react": "^14.3.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
