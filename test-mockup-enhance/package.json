{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:app": "node -e \"const f=require('fs');if(f.existsSync('prisma/schema.prisma'))require('child_process').execSync('prisma generate',{stdio:'inherit'})\" && vite build && tsc -p tsconfig.server.json && node scripts/seal-dist-esm.mjs",
    "build": "npm run build:app && tsc -p tsconfig.json --noEmit",
    "start": "node dist/server/index.js",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "test:acceptance": "playwright test --config=playwright.config.js",
    "dev:server": "tsx watch src/server/index.ts",
    "prebuild": "prisma generate --schema=prisma/schema.prisma || echo \"skipping prisma generate\"",
    "postbuild": "npm run build:server",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/server/index.js",
    "test": "npm run test:unit",
    "postinstall": "node scripts/prisma-env.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "prisma": "^6.19.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "tsx": "^4.19.2",
    "@testing-library/react": "^14.2.1",
    "@types/express": "^4.17.21",
    "esbuild": "^0.21.5",
    "@testing-library/user-event": "^14.5.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
