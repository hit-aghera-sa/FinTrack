{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/seal-dist-esm.mjs",
    "start": "node dist/server/index.js",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "test:visual-diff": "node scripts/check-design-tokens.mjs",
    "dev:api": "npx vite preview --port 4173 --strictPort",
    "dev:client": "vite",
    "test": "npm run test:acceptance",
    "test:acceptance": "playwright test --config=playwright.config.js",
    "dev:web": "vite",
    "build:app": "vite build && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "express": "*",
    "pg": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "@types/express": "^4.17.21",
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.2",
    "jsdom": "^25.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2"
  }
}
